{
  "name": "react-native-unity-show",
  "version": "0.1.7",
  "description": "React Native native module groundwork for a Unity bridge",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "exports": {
    ".": {
      "react-native-unity-show-source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./app.plugin": "./app.plugin.js",
    "./plugin": "./plugin/withUnityShow.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json",
    "react-native-unity-show.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn install && yarn example && yarn pods"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "dependencies": {
    "@expo/config-plugins": "~57.0.9"
  },
  "repository": "https://github.com/azesmway/react-native-unity-show",
  "author": "azesm <azesm@me.com> (https://github.com/azesmway)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/azesmway/react-native-unity-show/issues"
  },
  "homepage": "https://github.com/azesmway/react-native-unity-show#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.1",
    "eslint": "^9.39.5",
    "expo-modules-core": "57.0.17",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "pod-install": "^1.1.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "release-it": "^21.0.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "watchman": false,
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true,
          "sourceMaps": true
        }
      ],
      [
        "module",
        {
          "esm": true,
          "sourceMaps": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
